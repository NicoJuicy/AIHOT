# MyHOT configuration. Copy it to .env and edit (or run node scripts/init-env.ts, which creates .env with fresh random secrets).
# The frontend only gets the site address; every secret stays in the backend. Do not commit .env to Git.

# ===== Required =====

# The site's public address: generated links, RSS, share images and MCP all use it. For a local trial, use the one below.
SITE_URL=http://localhost:3000

# Admin password (at least 12 characters), for signing in to /admin.
ADMIN_PASSWORD=

# Secrets for signing sessions and image proxy URLs: a random string each (openssl rand -hex 32 makes one).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# The database password with Docker (the database exposes no port, but still use random characters).
POSTGRES_PASSWORD=

# Model: any OpenAI-compatible API works, and every step uses it by default. Below is the DeepSeek setup.
#LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
#LLM_MODEL=deepseek-flash
LLM_MODEL=gemma4:e2b
# Provider-specific request parameters (JSON), e.g. to turn thinking mode off:
LLM_EXTRA_JSON={"reasoning_effort":"none"}
# Examples for other providers:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   Zhipu     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Turn on if the model can see images (titles and summaries of picked content then take the first image into account):
# LLM_VISION=true
# Turn off if the service does not support JSON mode (response_format):
# LLM_JSON_MODE=false
# For reasoning models (they think before answering, and reasoning and answer share the output budget): extra output
# tokens reserved for reasoning, added to each step's own budget; 0 when unset.
# Set it when calls fail with "output token limit reached (finish_reason=length)", for example:
# LLM_REASONING_TOKENS=4000

# ===== Optional: more accurate story grouping =====

# Embedding recall: any OpenAI-compatible /embeddings API. It runs without one: grouping then finds candidates by text
# overlap, but discussion threads used only as heat evidence (hot_signal sources) mostly fail to attach to stories, so heat runs low.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Or set only an Alibaba Cloud Model Studio key to use text-embedding-v4:
# DASHSCOPE_API_KEY=
# Embedding dimensions (with EMBEDDING_* the default is what the service returns; Model Studio defaults to 1024). Changing it recomputes old embeddings:
# EMBEDDING_DIMS=

# ===== Optional: a different model for each step =====
# By default every step uses LLM_* above. To have a step use another provider, set a preset name (the matching key is required):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Preset names and the keys they need:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Note: with DASHSCOPE_API_KEY set and EMBEDDING_API_KEY unset, grouping automatically uses Model Studio embeddings (text-embedding-v4), billed separately at Model Studio prices.

# ===== Optional: paid collection services (billed per request, with budget breakers; tune them in admin "Settings") =====
# X (Twitter) accounts: SocialData
# SOCIALDATA_API_KEY=
# Browser-rendering fallback when the body text cannot be fetched: Jina Reader
# JINA_API_KEY=

# ===== Optional: Feishu =====
# Push picks to Feishu groups (only picks from T1 and T1_5 sources): enable in admin "Settings → Notification targets"; put the webhook URLs here.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alerts and forwarded feedback go to internal Feishu chats (feedback needs a custom Feishu app):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Alerts are plain text, so they can also go to a group's custom bot: with this set they go through the webhook instead of the app and chat IDs above (and use none of the app's API quota).
# FEISHU_ALERT_WEBHOOK_URL=
# Hand alerts to your own automation service first (e.g. a webhook relay that can wake an AI); used only with both set and FEISHU_INTERNAL_ENABLED=true:
# Alerts to handle are POSTed to this address (Authorization: Bearer <KEY>, JSON fields id, type, subject, summary, detail, link); a 200 means accepted, and the same id may be resent.
# Alerts, recoveries and the system digest meant for you are first POSTed to /tell at the root of the same host (JSON fields key, text), and go through Feishu above if not accepted. See "Updating" in docs/deploy.md.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# Sign in to the admin with a Feishu account (optional, alongside the admin password):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Optional: other =====
# Sent with JSON sources that read the GitHub API (api.github.com) for a higher quota. Free from GitHub; read-only access is enough:
# GITHUB_TOKEN=
# Token for external scripts pushing content into the site (POST /api/ingest/items), at least 16 characters; unset turns the endpoint off.
# INGEST_TOKEN=
# Maximum pushes per client per minute on the ingest endpoint (docker compose default 10); set 0 if a reverse proxy in front already rate-limits:
# INGEST_RATE_LIMIT=10
# When fetching overseas sources needs a proxy (e.g. a server in mainland China):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# When a source's feed or list address is a self-hosted service on the internal network (e.g. RSSHub on the same Docker network), list full host names, comma-separated (case-insensitive, no wildcards).
# Only these addresses themselves are allowed, directly and not through the proxy above; redirects to other hosts, article bodies and images still cannot reach the internal network, and link-local and cloud metadata addresses are always refused:
# PRIVATE_FEED_HOSTS=rsshub
# Traffic caps for the image proxy fetching from original sites (MB per minute, GB per day); past them, uncached images return 503 first. Unset uses DEPLOYMENT.imageUpstreamBudget in site/site.ts, which has no cap by default:
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Set to true behind a reverse proxy such as Caddy or Nginx, so visitor addresses are read from the proxy's X-Forwarded-For;
# keep false when the site faces the internet directly, so nobody can forge addresses to get around the sign-in and feedback limits.
TRUST_PROXY=false
# MCP accepts only requests sent to the SITE_URL domain (and localhost); list any other domains it is reached at here, comma-separated:
# MCP_ALLOWED_HOSTS=
# After how many minutes without new content the site counts as "stopped collecting" and alerts; unset uses ALERTS.quietMinutes in site/site.ts (default 360):
# ALERT_QUIET_MINUTES=360
# Submit new pages to IndexNow (Bing and others) daily; the key is 32 hex characters you generate yourself:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Daily database backups to S3-compatible object storage (Tencent Cloud COS, AWS S3, Alibaba Cloud OSS…).
# Without DB_BACKUP_STORE_DOMAIN the address is built for Tencent Cloud COS (<bucket>.cos.<region>.myqcloud.com);
# for other providers, set the access domain including the bucket name, e.g. my-bucket.s3.us-east-1.amazonaws.com for AWS S3:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Log level (default info) and database connection pool size (default 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Release name: shown on the admin "Runs" page and /api/health, to confirm the processes were replaced after an upgrade:
# AIHOT_RELEASE=
# Environment name, production or development by NODE_ENV by default; outside production, alerts carry it, and dev sign-in bypass works only outside production:
# AIHOT_ENVIRONMENT=
# Keep secrets in a directory, by group (models.env, collectors.env, integrations.env, auth.env), instead of here; values written here take precedence:
# AIHOT_CREDENTIALS_DIR=

# ===== Safety valves =====
# Sources are fetched (including the daily source icon refresh) and models called only when these are true; delete both lines or set false to stop both (useful when working on the UI).
# Every *_ENABLED switch in this file accepts only true; 1, yes or TRUE all count as off.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Needed only when running directly on this machine without Docker =====
# DATABASE_URL=postgres://username@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# Directory for uploaded files, the image cache and local backups (default .data in the repository):
# AIHOT_DATA_DIR=/var/lib/myhot
# Sign in to the admin without a password during development (production refuses to start with it), and the name the admin shows:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetching internal network addresses while debugging locally (off by default; production refuses to start with it):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== With docker compose --profile https =====
# SITE_DOMAIN=example.com
# The port the site opens on this machine (for docker compose; default 3000, reachable on all interfaces); with HTTPS it is only for the local Caddy, not exposed directly:
# PORT=127.0.0.1:3000
# Also change TRUST_PROXY above to true.

# Local only: Hacker News refuses the default User-Agent while SITE_URL is localhost.
CRAWLER_USER_AGENT=MyHOTBot/1.0 (+http://localhost:3000/about)
